SOURCE=alsa
ALSA_DEVICE=default
EVENT_THRESHOLD=0.3
EVENT_REFRACTORY=10
# one acoustic episode (car pass, bark…) = one logged event; strongest class wins
EPISODE_REFRACTORY=10
# classes never logged (false-positive filter); separator ";" because AudioSet
# names contain commas; e.g. impossible-in-city noises:
EVENT_BLOCKLIST=Livestock, farm animals, working animals;Cattle, bovinae;Moo;Cowbell;Pig;Oink;Goat;Bleat;Sheep;Chicken, rooster;Cluck;Crowing, cock-a-doodle-doo;Gobble;Turkey;Fowl;Horse;Neigh, whinny;Owl;Hoot;Whale vocalization;Sonar;Roaring cats (lions, tigers);Gunshot, gunfire;Machine gun;Artillery fire;Cap gun;Arrow;Printer;Typewriter;Typing;Inside, small room;Tuning fork;Timpani;Gong;Sine wave;Silence;White noise
SPL_INTERVAL=1

OLLAMA_MODEL=llama3.2:3b
SUMMARY_HOUR=7
TZ=UTC
